// ============================================================
// Example 1: Method Flowchart (方法流程图)
// Scenario: BMS cell balancing method with decision branch
// Best practices demonstrated:
//   - Flat ellipse start/end, sharp box steps, flat diamond decision
//   - Box w/h ≥ 3:1, diamond w/h ≈ 2:1
//   - Lead lines: thin dotted (0.35pt), outside boxes, clockwise
//   - Decision exits labeled 是/否
//   - Linear numbering 10,20,30,40,50
//   - rankdir=TB, B&W, "图1" below
// ============================================================

digraph MethodFlowchart {
    // --- Global ---
    rankdir=TB;  bgcolor=white;  splines=ortho;
    fontname="Arial";
    node [fontname="Arial", fontsize=14, fontcolor=black, color=black, penwidth=0.6];
    edge [fontname="Arial", fontsize=11, fontcolor=black, color=black, penwidth=0.6];

    // --- Nodes ---
    start   [label="开始",                shape=ellipse, width=1.8, height=0.5];
    detect  [label="检测各电芯电压",       shape=box,     width=3.2, height=0.7];
    decide  [label="是否需\n要均衡?",      shape=diamond, width=3.0, height=1.5];
    balance [label="执行均衡策略",         shape=box,     width=3.2, height=0.7];
    end     [label="结束",                shape=ellipse, width=1.8, height=0.5];

    // --- Flow ---
    start   -> detect;
    detect  -> decide;
    decide  -> balance [xlabel="是"];
    balance -> end;
    decide  -> end     [xlabel="否"];

    // --- Reference numbers (plaintext outside, clockwise) ---
    node [shape=plaintext, fontsize=11];
    edge [style=invis, weight=100];
    r10 [label="10"];  r20 [label="20"];  r30 [label="30"];
    r40 [label="40"];  r50 [label="50"];

    { rank=same; r10; start; }   { rank=same; r20; detect; }
    { rank=same; r30; decide; }  { rank=same; r40; balance; }
    { rank=same; r50; end; }

    // --- Lead lines: thin, dotted, no arrowhead ---
    edge [style=dotted, penwidth=0.35, arrowhead=none, constraint=false, color=black];
    r10 -> start;  r20 -> detect;  r30 -> decide;
    r40 -> balance;  r50 -> end;

    // --- Figure caption ---
    label="图1";  labelloc="b";  fontsize=12;
}
