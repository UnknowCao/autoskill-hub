// ============================================================
// Example 4: Process with Error Handling (含异常分支的流程图)
// Scenario: Data acquisition with validation, retry, and error paths
// Best practices demonstrated:
//   - Multiple decision diamonds
//   - Loop-back (retry path)
//   - Alternative success/failure endpoints
//   - Flat ellipses for start/end, sharp boxes for actions
//   - Arrow routing through safe channels between ranks
//   - Decision exits: Yes→right, No→left/down
// ============================================================

digraph ProcessWithErrorHandling {
    // --- Global ---
    rankdir=TB;  bgcolor=white;  splines=ortho;
    nodesep=0.5;  ranksep=0.9;
    fontname="Arial";
    node [fontname="Arial", fontsize=14, fontcolor=black, color=black, penwidth=0.6];
    edge [fontname="Arial", fontsize=11, fontcolor=black, color=black, penwidth=0.6];

    // --- Start ---
    start [label="开始", shape=ellipse, width=1.8, height=0.5];

    // --- Process steps (sharp box, w/h ≥ 3:1) ---
    node [shape=box, width=3.2, height=0.7];
    acquire [label="采集传感器数据"];
    process [label="数据预处理与滤波"];
    transmit[label="发送数据到上位机"];

    // --- Decision diamonds (flat, w/h ≈ 2:1) ---
    node [shape=diamond, width=3.0, height=1.5];
    valid   [label="数据\n有效?"];
    retry   [label="重试次数\n< 3?"];

    // --- Error handling ---
    node [shape=box, width=3.2, height=0.7];
    logerr  [label="记录错误日志"];
    abort   [label="中止并报警"];

    // --- Endpoints ---
    success [label="完成", shape=ellipse, width=1.8, height=0.5];
    failure [label="异常终止", shape=ellipse, width=1.8, height=0.5];

    // --- Main flow ---
    start    -> acquire;
    acquire  -> valid;
    valid    -> process  [xlabel="是"];
    process  -> transmit;
    transmit -> success;

    // --- Validation failure → retry decision ---
    valid    -> retry    [xlabel="否"];
    retry    -> acquire  [xlabel="是 (重试)"];
    retry    -> logerr   [xlabel="否 (超限)"];

    // --- Error path ---
    logerr   -> abort;
    abort    -> failure;

    // --- Reference numbers ---
    node [shape=plaintext, fontsize=10];
    edge [style=invis, weight=100];
    r10 [label="10"]; r20 [label="20"]; r30 [label="30"];
    r40 [label="40"]; r50 [label="50"]; r60 [label="60"];
    r70 [label="70"]; r80 [label="80"];

    { rank=same; r10; start; }    { rank=same; r20; acquire; }
    { rank=same; r30; valid; }    { rank=same; r40; process; }
    { rank=same; r50; transmit; } { rank=same; r60; success; }
    { rank=same; retry; logerr; }  // error branch
    { rank=same; r70; abort; }    { rank=same; r80; failure; }

    // --- Lead lines ---
    edge [style=dotted, penwidth=0.35, arrowhead=none, constraint=false, color=black];
    r10 -> start;   r20 -> acquire;  r30 -> valid;
    r40 -> process; r50 -> transmit; r60 -> success;
    r70 -> abort;   r80 -> failure;

    // --- Figure caption ---
    label="图1";  labelloc="b";  fontsize=12;
}
