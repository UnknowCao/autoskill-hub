digraph Flowchart {
	graph [bgcolor=white fontname=Arial rankdir=TB]
	node [color=black fontcolor=black fontname=Arial fontsize=14 penwidth=0.6]
	edge [color=black fontcolor=black fontname=Arial fontsize=11 penwidth=0.6]
	fontsize=12 label="图1" labelloc=b
	start [label="开始" height=0.5 shape=ellipse width=1.8]
	step1 [label="步骤一" height=0.6 shape=box width=3.0]
	dec1 [label="条件?" height=1.4 shape=diamond width=2.8]
	end [label="结束" height=0.5 shape=ellipse width=1.8]
	start -> step1
	step1 -> dec1
	dec1 -> step2 [label="是"]
	dec1 -> end [label="否"]
}
